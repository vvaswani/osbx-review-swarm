# Copy to .env and fill in your real values
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Required OpenRouter model references for each pipeline stage. Include the
# desired version/tag in each value. Values may be the same across stages.
OPENROUTER_REVIEWER_MODEL=openrouter/deepseek/deepseek-chat-v3.1:free
OPENROUTER_REFUTER_MODEL=openrouter/deepseek/deepseek-chat-v3.1:free
OPENROUTER_DEVELOPER_MODEL=openrouter/deepseek/deepseek-chat-v3.1:free

# GitHub token with repo read + push rights (for PR comments, fix branches)
# GH_TOKEN matches GitHub Secrets convention — this is the expected env var name
GH_TOKEN=ghp_...

# OpenSandbox configuration (server/mcp are Python infrastructure)
OPENSANDBOX_INSECURE_SERVER=YES
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_MCP_URL=http://localhost:8000/mcp
