# Copy to .env and fill in your keys
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# GitHub token with repo read + push rights (fix branches)
GITHUB_TOKEN=ghp_...

# Use insecure mode to skip API key auth on the sandbox server (local dev)
OPENSANDBOX_INSECURE_SERVER=YES

# Optional overrides
OPENROUTER_MODEL=openrouter/deepseek/deepseek-chat-v3.1:free
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_MCP_URL=http://localhost:8000/mcp
OPENSANDBOX_IMAGE=review-swarm-sandbox:latest
HOST=0.0.0.0
PORT=8081
