{
  "name": "books-app",
  "version": "1.0.0",
  "description": "Books CRUD application (Fastify + TypeScript + Drizzle ORM)",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun run src/main.ts",
    "lint": "bunx tsc --noEmit && bunx eslint src/ --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/main.ts --outdir dist"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
