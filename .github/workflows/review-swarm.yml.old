name: Code Review Swarm

on:
  pull_request:
    types: [opened, synchronize]
    branches: [main]
    paths:
      - 'app/**'

# Cancel previous runs for the same PR when a new commit is pushed
concurrency:
  group: review-swarm-${{ github.event.pull_request.number }}
  cancel-in-progress: true

permissions:
  contents: write
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v1
        with:
          version: '1.4'

      - name: Install OpenSandbox (Python infrastructure — sandbox management)
        run: pip install opensandbox opensandbox-server opensandbox-mcp
        # NOTE: OpenSandbox is Python-only; this is the only Python dependency in CI.
        # All agent code, app code, and sandbox image are TypeScript/Bun.

      - name: Start OpenSandbox server
        run: |
          OPENSANDBOX_INSECURE_SERVER=YES opensandbox-server --port 8080 &
          sleep 5

      - name: Start OpenSandbox MCP server
        run: |
          OPENSANDBOX_INSECURE_SERVER=YES opensandbox-mcp \
            --domain localhost:8080 --protocol http --transport streamable-http &
          sleep 3

      - name: Install agent dependencies
        run: |
          cd agent
          bun install --frozen-lockfile

      - name: Run code review swarm
        env:
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: |
          cd agent
          bun run src/main.ts \
            --repository "${{ github.repository }}" \
            --pr-number ${{ github.event.pull_request.number }}
